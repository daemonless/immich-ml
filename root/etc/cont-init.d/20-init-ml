#!/bin/sh
# Initialize Immich ML

mkdir -p /cache /config

# Chown the volumes to 'bsd', but skip the slow recursive pass when the marker
# already records the current PUID:PGID (re-chown only on first run or a PUID
# change). Marker written before the chown so it gets owned too.
# SKIP_CHOWN=false forces a chown every start.
SKIP_CHOWN=${SKIP_CHOWN:-true}
WANT="${PUID:-1000}:${PGID:-1000}"

if [ "${SKIP_CHOWN}" = "true" ] && [ "$(cat /config/.chown_done 2>/dev/null)" = "$WANT" ]; then
    echo "Ownership already $WANT; skipping recursive chown."
else
    echo "Fixing permissions ($WANT)..."
    echo "$WANT" > /config/.chown_done
    chown -R bsd:bsd /cache /config
fi

echo "Immich ML initialized."
