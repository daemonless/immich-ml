#!/bin/sh
exec 2>&1

echo "Starting Immich ML..."

# Set HOME so gunicorn's control socket (~/.gunicorn)
export HOME=/config
export MPLCONFIGDIR=/tmp
export HF_HOME=/cache/huggingface

# Work around onnxruntime 1.31's F_KINFO bug on FreeBSD (Containerfile.j2 has the details).
[ -f /usr/local/lib/fkinfo_shim.so ] && export LD_PRELOAD="/usr/local/lib/fkinfo_shim.so${LD_PRELOAD:+ $LD_PRELOAD}"

cd /opt/venv
exec /opt/venv/bin/python -m gunicorn \
    immich_ml.main:app \
    -k uvicorn.workers.UvicornWorker \
    -b ${MACHINE_LEARNING_HOST:-0.0.0.0}:${MACHINE_LEARNING_PORT:-3003} \
    -w ${MACHINE_LEARNING_WORKERS:-1} \
    --timeout ${MACHINE_LEARNING_WORKER_TIMEOUT:-300}
